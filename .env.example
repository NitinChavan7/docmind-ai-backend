PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/docmind_ai
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Generate two different values: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=docmind-ai
JWT_AUDIENCE=docmind-ai-web
# Optional; use the same Google Web client ID in the frontend.
GOOGLE_CLIENT_ID=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=document_chunks

# Streaming generation safeguards (counts and rate limits are per backend process).
GENERATION_TIMEOUT_MS=180000
MAX_CONCURRENT_GENERATIONS=4
MAX_USER_GENERATIONS=1
GENERATION_RATE_LIMIT=20
