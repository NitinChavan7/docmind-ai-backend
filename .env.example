PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/docmind_ai
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Generate two different values: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=docmind-ai
JWT_AUDIENCE=docmind-ai-web
# Optional; use the same Google Web client ID in the frontend.
GOOGLE_CLIENT_ID=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks_v2
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Streaming generation safeguards (counts and rate limits are per backend process).
GENERATION_TIMEOUT_MS=180000
MAX_CONCURRENT_GENERATIONS=4
MAX_USER_GENERATIONS=1
GENERATION_RATE_LIMIT=20
# Follow-up rewriting falls back to the original question after this deadline.
QUESTION_REWRITE_TIMEOUT_MS=8000
# GPT-OSS only: low favors latency; medium/high allow more reasoning.
GROQ_REASONING_EFFORT=low

# Free-plan quotas. Positive integers only; invalid values stop startup.
FREE_MAX_PDFS=5
FREE_MAX_PDF_SIZE_MB=10
FREE_MAX_TOTAL_STORAGE_MB=30
FREE_MAX_PDF_PAGES=25
FREE_MAX_CHATS=10
FREE_MAX_QUESTIONS_PER_CHAT=50
FREE_MAX_DAILY_QUESTIONS=30
FREE_MAX_CHAT_REQUESTS_PER_MINUTE=5
FREE_MAX_CONCURRENT_GENERATIONS=1
FREE_PDF_RETENTION_DAYS=30
FREE_CHAT_RETENTION_DAYS=30
